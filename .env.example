# ==========================================
# KONFIGURASI GOOGLE GEMINI AI
# ==========================================

# 1. Masukkan API Key dari Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="masukkan_api_key_gemini_anda_disini"

# 2. Pilihan Model Gemini (Opsional, Default: gemini-2.0-flash)
# Anda dapat meng-override model sesuai kebutuhan dengan menulis ID model persis seperti di bawah:
#
# Pilihan Model yang Didukung:
# - gemini-2.0-flash        -> (Default & Direkomendasikan) Cepat, cerdas, akurat
# - gemini-2.0-flash-lite   -> Versi hemat kuota & latency sangat rendah
# - gemini-1.5-flash        -> Versi stabil generasi 1.5
# - gemini-1.5-pro          -> Tingkat penalaran mendalam & analisis komprehensif
# - gemini-2.5-flash        -> Generasi 2.5 Flash
# - gemini-2.5-pro          -> Generasi 2.5 Pro
GEMINI_MODEL="gemini-2.0-flash"
